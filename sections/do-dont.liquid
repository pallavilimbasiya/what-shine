<style>
  .dodont_wrapper {
    display: flex;
    flex-wrap: wrap;
    /* flex-direction: column; */
  }
  .dodont_wrapper > div.do {
    flex: 50%;
  
  }
  .dodont_wrapper > div.dont {
    flex: 50%;
 
  }
</style>

<div class="page-width">
  <h3 style="text-align: center">Do & Donts</h3>

 <div class="dodont_wrapper">
 
    
    <div class="do">
       {% for block in  section.blocks %}
       {% if block.settings.do-text  %}
            <p><b>Do: </b>{{ block.settings.do-text }}</p>
          {% endif %}
      {% endfor %}
    </div> 
      
 
    <div class="dont">
      {% for block in  section.blocks %}
       {% if  block.settings.dont-text %}
              <p><b>Don't: </b>{{ block.settings.dont-text }}</p>
           {% endif %}
       {% endfor %}
    </div> 
  
 </div>
</div>



{% schema %}
  {
    "name": "do-donts",
    "settings": [],
    "blocks": [
      {
        "type": "text",
        "name": "Do",
        "settings": [
            {
              "type": "inline_richtext",
              "id": "do-text",
              "label": "Do:"
            }
        ]
      },
      {
        "type": "quote",
        "name": "Donts",
        "settings": [
          {
            "type": "inline_richtext",
            "id": "dont-text",
            "label": "Don't:"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Do Donts"
      }
    ]
  }
{% endschema %}















