<style>
  .dodont_wrapper {
    display: flex;
    flex-wrap: wrap;
    /* flex-direction: column; */
  }
  .dodont_wrapper > div.do {
    flex: 50%;
    order: 1;
  }
  .dodont_wrapper > div.dont {
    flex: 50%;
    order: 2;
  }
</style>

<div class="page-width">
  <h3 style="text-align: center">Do & Donts</h3>

 <div class="dodont_wrapper">
  {% for block in  section.blocks %}
     {% if block.settings.do-text %}
    <div class="do">
         
            <p><b>Do:</b>{{ block.settings.do-text }}</p>
           
    </div> {% endif %}
    {% if block.settings.dont-text %}
    <div class="dont">
            
              <p><b>Don't:</b>{{ block.settings.dont-text }}</p>
           
    </div> {% endif %}
  {% endfor %}
 </div>
</div>



{% schema %}
  {
    "name": "do-donts",
    "settings": [],
    "blocks": [
      {
        "type": "text",
        "name": "Do",
        "settings": [
            {
              "type": "inline_richtext",
              "id": "do-text",
              "label": "Do:"
            }
        ]
      },
      {
        "type": "quote",
        "name": "Donts",
        "settings": [
          {
            "type": "inline_richtext",
            "id": "dont-text",
            "label": "Don't:"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Do Donts"
      }
    ]
  }
{% endschema %}
















